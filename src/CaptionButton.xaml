<ControlTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 TargetType="{x:Type Button}">
    <!-- The clear surface receives clicks. Only the disc paints interaction states. -->
    <Grid Background="Transparent">
        <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse x:Name="Disc" Fill="{TemplateBinding Foreground}" Stroke="#39000000" StrokeThickness="0.75"/>
            <Ellipse x:Name="PressShade" Fill="#35000000" Visibility="Hidden"/>
            <Path x:Name="Glyph" Data="{TemplateBinding Content}" Stroke="#CC201918" StrokeThickness="1.35"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden"/>
        </Grid>
    </Grid>
    <ControlTemplate.Triggers>
        <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="Disc" Property="Fill" Value="#FF81848A"/>
        </MultiDataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Disc" Property="Stroke" Value="White"/>
            <Setter TargetName="Disc" Property="StrokeThickness" Value="1.5"/>
            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="PressShade" Property="Visibility" Value="Visible"/>
        </Trigger>
    </ControlTemplate.Triggers>
</ControlTemplate>
